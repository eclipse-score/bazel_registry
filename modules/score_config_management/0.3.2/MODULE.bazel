module(name = "score_config_management",
    version = "0.3.2"
)

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "rules_python", version = "1.8.5")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "platforms", version = "1.0.0")

PYTHON_VERSION = "3.12"

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = PYTHON_VERSION,
)
use_repo(python)

# Add GoogleTest dependency
bazel_dep(name = "googletest", version = "1.17.0.bcr.2")

# Rust rules for Bazel
bazel_dep(name = "rules_rust", version = "0.68.1-score")

# C/C++ rules for Bazel
bazel_dep(name = "rules_cc", version = "0.2.17")

# LLVM Toolchains Rules - host configuration
# 1.8.0 force-includes a generated redacted_dates.h via -imacros (PR bazel-contrib/toolchains_llvm#756)
# which isn't wired into assembly-compile actions, breaking rules_rust cc-rs crates
# (e.g. psm) with "file not found". Reverted in #825, fixed starting 1.9.0.
bazel_dep(name = "toolchains_llvm", version = "1.9.1", dev_dependency = True)

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm", dev_dependency = True)
llvm.toolchain(
    cxx_standard = {"": "c++17"},
    llvm_version = "19.1.0",
    # toolchains_llvm 1.8.0 defaults to its bundled libc++ and emits
    # -stdlib=libc++ (an unused-argument error under warnings-as-errors);
    # pin libstdc++ to keep the exact 1.6.0 behavior for regular builds.
    stdlib = {"": "stdc++"},
)

# Coverage-only Clang instance (covmap for the LLVM coverage pipeline from
# @score_tooling//coverage; selected only under --config=llvm_cov). Separate
# from the 19.1.0 default instance so regular builds stay untouched.
llvm.toolchain(
    name = "llvm_toolchain_coverage",
    cxx_standard = {"": "c++17"},
    extra_known_features = [
        "@score_tooling//coverage:enable_llvm_coverage_for_death_tests",
    ],
    llvm_version = "22.1.7",
    stdlib = {"": "stdc++"},
)
use_repo(llvm, "llvm_toolchain", "llvm_toolchain_coverage", "llvm_toolchain_coverage_llvm", "llvm_toolchain_llvm")

# Score C++ toolchain — used for --config=host_gcc in CI (tests, static-analysis)
bazel_dep(name = "score_bazel_platforms", version = "1.1.0", dev_dependency = True)
bazel_dep(name = "score_bazel_cpp_toolchains", version = "1.0.3", dev_dependency = True)

# score_devcontainer 1.11.1 was yanked upstream (retagged release, checksum mismatch);
# force resolution to the fixed 1.11.2 release.
bazel_dep(name = "score_devcontainer", version = "1.11.4", dev_dependency = True)

gcc = use_extension("@score_bazel_cpp_toolchains//extensions:gcc.bzl", "gcc", dev_dependency = True)
gcc.toolchain(
    name = "score_gcc_x86_64_toolchain",
    target_cpu = "x86_64",
    target_os = "linux",
    use_default_package = True,
    version = "12.2.0",
)

# QNX cross-compiler toolchains (QCC)
gcc.toolchain(
    name = "score_qcc_x86_64_toolchain",
    sdp_version = "8.0.4",
    target_cpu = "x86_64",
    target_os = "qnx",
    use_default_package = True,
    version = "12.2.0",
)
gcc.toolchain(
    name = "score_qcc_aarch64_toolchain",
    sdp_version = "8.0.4",
    target_cpu = "aarch64",
    target_os = "qnx",
    use_default_package = True,
    version = "12.2.0",
)
use_repo(
    gcc,
    "score_gcc_x86_64_toolchain",
    "score_qcc_aarch64_toolchain",
    "score_qcc_aarch64_toolchain_pkg",
    "score_qcc_x86_64_toolchain",
    "score_qcc_x86_64_toolchain_pkg",
)

# UTs on QNX — run_under wrapper that boots QEMU
bazel_dep(name = "score_qnx_unit_tests", version = "0.3.0", dev_dependency = True)
bazel_dep(name = "score_rules_imagefs", version = "0.1.0", dev_dependency = True)

imagefs = use_extension("@score_rules_imagefs//extensions:imagefs.bzl", "imagefs", dev_dependency = True)
imagefs.toolchain(
    name = "score_qnx_x86_64_ifs_toolchain",
    sdp_to_import = "@score_qcc_x86_64_toolchain_pkg",
    sdp_version = "8.0.0",
    target_cpu = "x86_64",
    target_os = "qnx",
    type = "ifs",
)
imagefs.toolchain(
    name = "score_qnx_aarch64_ifs_toolchain",
    sdp_to_import = "@score_qcc_aarch64_toolchain_pkg",
    sdp_version = "8.0.0",
    target_cpu = "aarch64",
    target_os = "qnx",
    type = "ifs",
)
use_repo(imagefs, "score_qnx_aarch64_ifs_toolchain", "score_qnx_x86_64_ifs_toolchain")

# Ferrocene (safety-certified Rust) — needed for Rust targets on QNX
bazel_dep(name = "score_toolchains_rust", version = "0.10.0", dev_dependency = True)

# tooling
# 2.2.1 contains the sphinx_module/docs_library_deps/dependable_element
# features the old git_override existed for, and no longer depends on svglib
# (the override patch is obsolete).
bazel_dep(name = "score_tooling", version = "3.0.2")

bazel_dep(name = "aspect_rules_lint", version = "2.3.0", dev_dependency = True)
bazel_dep(name = "buildifier_prebuilt", version = "8.5.1", dev_dependency = True)

# Pin grpc-java (plain bazel_dep, not single_version_override, so it propagates to consumers) to work around BCR grpc@1.70.1 breakage (see eclipse-score/lifecycle, https://github.com/grpc/grpc-java/issues/12165).
bazel_dep(name = "grpc-java", version = "1.70.0")

# s-core base libs
bazel_dep(name = "score_baselibs", version = "0.2.14")

# s-core communication
bazel_dep(name = "score_communication", version = "0.5.0")

# New mw::com APIs are not in a published release yet. Pinned to the earliest
# commit with ProvidedServicesContainer (2026-10-01) rather than a later one,
# since this commit still requires score_tooling@2.2.2 - newer commits bump to
# score_tooling@2.3.1 (removes the `fmea` rule we use) and a much larger set
# of transitive deps, which broke the exec-platform Rust toolchain used by docs.
git_override(
    module_name = "score_communication",
    commit = "522cf18c557beabd3c8b6ce7fd805418fb37c045",
    remote = "https://github.com/eclipse-score/communication.git",
)

bazel_dep(name = "score_logging", version = "0.2.4")
bazel_dep(name = "score_lifecycle", version = "0.7.0")

# s-core persistency
bazel_dep(name = "score_persistency", version = "0.3.5")

# TRLC / lobster: versions matching score_tooling 3.0.2
bazel_dep(name = "trlc", version = "3.1.1", dev_dependency = True)
bazel_dep(name = "lobster", version = "1.0.6", dev_dependency = True)
