module(name = "score_persistency",
    version = "0.4.1"
)

# Bazel global rules (alphabetically sorted)
bazel_dep(name = "rules_cc", version = "0.2.26")
bazel_dep(name = "rules_python", version = "1.8.5")
bazel_dep(name = "rules_rust", version = "0.68.2-score")

# External dependencies for production (alphabetically sorted)
bazel_dep(name = "score_baselibs", version = "0.2.17")
bazel_dep(name = "score_crates", version = "0.0.13")
bazel_dep(name = "score_docs_as_code", version = "8.7.0")
bazel_dep(name = "score_logging", version = "0.2.6")
bazel_dep(name = "score_platform", version = "0.7.4")
bazel_dep(name = "score_process_description", version = "2.2.3")
bazel_dep(name = "score_test_scenarios", version = "0.5.0")
bazel_dep(name = "score_tooling", version = "3.0.2")

# LLVM source-based coverage pipeline (C++ + Rust): the qualified S-CORE
# coverage tool, successor of @score_tooling//coverage. See quality/coverage/.
bazel_dep(name = "score_coverage", version = "0.4.2", dev_dependency = True)

# Development dependencies (alphabetically sorted)
# aspect_rules_lint 2.6.0 moved lint/clippy.bzl into a nested module.
# @score_rust_policies//clippy:linters.bzl (0.0.5) doesn't load that nested module yet.
# Bump once score_rust_policies supports aspect_rules_lint >= 2.6.
bazel_dep(name = "aspect_rules_lint", version = "2.5.2", dev_dependency = True)
bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.3", dev_dependency = True)
bazel_dep(name = "googletest", version = "1.18.0", dev_dependency = True)
bazel_dep(name = "rules_oci", version = "2.3.0", dev_dependency = True)
bazel_dep(name = "rules_pkg", version = "1.2.0", dev_dependency = True)
bazel_dep(name = "score_itf", version = "0.7.0", dev_dependency = True)
bazel_dep(name = "score_sbom", version = "0.1.1", dev_dependency = True)
bazel_dep(name = "score_rust_policies", version = "0.0.5", dev_dependency = True)
bazel_dep(name = "score_tools", version = "0.0.4", dev_dependency = True)

# Python toolchain configuration
PYTHON_VERSION = "3.12"

python = use_extension("@rules_python//python/extensions:python.bzl", "python", dev_dependency = True)
python.toolchain(
    is_default = True,
    python_version = PYTHON_VERSION,
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip", dev_dependency = True)
pip.parse(
    hub_name = "pip_score_persistency_venv_test",
    python_version = PYTHON_VERSION,
    requirements_lock = "//score/kvs/tests/test_cases:requirements.txt.lock",
)
use_repo(pip, "pip_score_persistency_venv_test")

# Toolchain dependencies.
bazel_dep(name = "score_bazel_cpp_toolchains", version = "1.0.5", dev_dependency = True)

bazel_dep(name = "score_bazel_platforms", version = "1.1.0")
bazel_dep(name = "platforms", version = "1.1.0")

bazel_dep(name = "score_toolchains_rust", version = "0.10.0", dev_dependency = True)
bazel_dep(name = "score_rules_imagefs", version = "0.1.0", dev_dependency = True)
bazel_dep(name = "score_cpp_policies", version = "0.1.2", dev_dependency = True)

# C++ toolchain configuration
# score_bazel_cpp_toolchains 1.0.0 removed its built-in warning features; inject them instead.
WARNING_FEATURES = [
    "@score_cpp_policies//warnings/gcc/features:minimal_warnings",
    "@score_cpp_policies//warnings/gcc/features:strict_warnings",
    "@score_cpp_policies//warnings/gcc/features:all_wall_warnings",
    "@score_cpp_policies//warnings/gcc/features:warnings_as_errors",
]

# Same for the sanitizer features. UBSan needs a compiler-specific variant on top of the base.
SANITIZER_FEATURES = [
    "@score_cpp_policies//sanitizers/features:debug_symbols",
    "@score_cpp_policies//sanitizers/features:asan",
    "@score_cpp_policies//sanitizers/features:ubsan_base",
    "@score_cpp_policies//sanitizers/features:lsan",
    "@score_cpp_policies//sanitizers/features:tsan",
]

GCC_SANITIZER_FEATURES = SANITIZER_FEATURES + ["@score_cpp_policies//sanitizers/features:ubsan_gcc"]

LLVM_SANITIZER_FEATURES = SANITIZER_FEATURES + ["@score_cpp_policies//sanitizers/features:ubsan_clang"]

# Linux C++ toolchains.
gcc = use_extension("@score_bazel_cpp_toolchains//extensions:gcc.bzl", "gcc", dev_dependency = True)
gcc.toolchain(
    name = "score_gcc_x86_64_toolchain",
    extra_known_features = WARNING_FEATURES + GCC_SANITIZER_FEATURES,
    target_cpu = "x86_64",
    target_os = "linux",
    use_default_package = True,
    version = "12.2.0",
)
gcc.toolchain(
    name = "score_gcc_aarch64_toolchain",
    extra_known_features = WARNING_FEATURES + GCC_SANITIZER_FEATURES,
    target_cpu = "aarch64",
    target_os = "linux",
    use_default_package = True,
    version = "12.2.0",
)

# QNX C++ toolchains.
gcc.toolchain(
    name = "score_qcc_x86_64_toolchain",
    extra_known_features = WARNING_FEATURES + GCC_SANITIZER_FEATURES,
    sdp_version = "8.0.4",
    target_cpu = "x86_64",
    target_os = "qnx",
    use_default_package = True,
    version = "12.2.0",
)
gcc.toolchain(
    name = "score_qcc_aarch64_toolchain",
    extra_known_features = WARNING_FEATURES + GCC_SANITIZER_FEATURES,
    sdp_version = "8.0.4",
    target_cpu = "aarch64",
    target_os = "qnx",
    use_default_package = True,
    version = "12.2.0",
)
use_repo(
    gcc,
    "score_gcc_aarch64_toolchain",
    "score_gcc_x86_64_toolchain",
    "score_qcc_aarch64_toolchain",
    "score_qcc_aarch64_toolchain_pkg",
    "score_qcc_x86_64_toolchain",
    "score_qcc_x86_64_toolchain_pkg",
)

# QNX image toolchains.
imagefs = use_extension("@score_rules_imagefs//extensions:imagefs.bzl", "imagefs", dev_dependency = True)
imagefs.toolchain(
    name = "score_qnx_aarch64_ifs_toolchain",
    sdp_to_import = "@score_qcc_aarch64_toolchain_pkg",
    sdp_version = "8.0.0",
    target_cpu = "aarch64",
    target_os = "qnx",
    type = "ifs",
)
imagefs.toolchain(
    name = "score_qnx_x86_64_ifs_toolchain",
    sdp_to_import = "@score_qcc_x86_64_toolchain_pkg",
    sdp_version = "8.0.0",
    target_cpu = "x86_64",
    target_os = "qnx",
    type = "ifs",
)
use_repo(
    imagefs,
    "score_qnx_aarch64_ifs_toolchain",
    "score_qnx_x86_64_ifs_toolchain",
)

# SBOM metadata: tracks module versions used by the //:sbom target
# (see root BUILD file).
sbom_ext = use_extension("@score_sbom//:extensions.bzl", "sbom_metadata", dev_dependency = True)

# score_baselibs is the only C++ module dependency of the product targets.
# Its version is read from its own MODULE.bazel.
# Its license is not part of the bundled cpp_metadata.json cache of score_sbom.
sbom_ext.track_module(name = "score_baselibs")
sbom_ext.license(
    name = "score_baselibs",
    license = "Apache-2.0",
    supplier = "Eclipse Foundation",
)
use_repo(sbom_ext, "sbom_metadata")

# *******************************************************************************
# Coverage toolchain (LLVM source-based coverage pipeline from
# @score_coverage, see quality/coverage/). Only active during
# `bazel coverage --config=llvm_cov` runs.
#
# C++ needs the hermetic Clang toolchain below (covmap instrumentation).
# Rust needs nothing extra: the standard @score_toolchains_rust//toolchains/
# ferrocene toolchain registered in score.bazelrc/score_toolchain.bazelrc
# ships llvm-cov/llvm-profdata since score_toolchains_rust 0.10.0, which
# activates Rust coverage instrumentation under `bazel coverage`.
# *******************************************************************************
bazel_dep(name = "toolchains_llvm", version = "1.11.1", dev_dependency = True)

llvm = use_extension(
    "@toolchains_llvm//toolchain/extensions:llvm.bzl",
    "llvm",
    dev_dependency = True,
)
llvm.toolchain(
    cxx_standard = {"": "c++17"},
    extra_known_features = [
        "@score_coverage//:enable_llvm_coverage_for_death_tests",
    ] + WARNING_FEATURES + LLVM_SANITIZER_FEATURES,
    link_libs = {"": [
        "-lrt",
        "-latomic",
    ]},
    llvm_version = "22.1.7",
    stdlib = {"": "stdc++"},
)
use_repo(llvm, "llvm_toolchain", "llvm_toolchain_llvm")

# ITF - base image of the docker backend.
oci = use_extension("@rules_oci//oci:extensions.bzl", "oci", dev_dependency = True)
oci.pull(
    name = "ubuntu",
    digest = "sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55",
    image = "docker.io/library/ubuntu",
    platforms = ["linux/amd64"],
    tag = "24.04",
)
use_repo(oci, "ubuntu", "ubuntu_linux_amd64")
