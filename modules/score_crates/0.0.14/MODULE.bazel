crate.annotation(
    crate = "iceoryx2-bb-derive-macros-qnx8",
    # The label is hard-coded to the canonical repo name on purpose: the patch labels are part of the
    # crate_universe digest stored in Cargo.Bazel.lock. "//patches:..." renders as "@@//patches:..." when
    # score_crates is the root module but "@@score_crates+//patches:..." when it is a dependency, so the
    # lockfile could only match one of the two. Consumers cannot repin it (rules_rust >= 0.71), so it must
    # match as a dependency. Note: fetching this crate when score_crates is the root module fails.
    patches = ["@@score_crates+//patches:iceoryx2_bb_derive_macros_readme.patch"],
    repositories = ["crate_index"],
)
crate.spec(
    git = "https://github.com/qorix-group/iceoryx2.git",
    package = "iceoryx2-bb-elementary-qnx8",
    rev = "9f5622f554de48a7a296e1a5a71200b01e35a502",
)
